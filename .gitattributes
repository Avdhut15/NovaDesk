# Normalise line endings to LF on commit, checkout as-is on Windows
* text=auto eol=lf

# Force these to always be LF
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.prisma text eol=lf
*.env.example text eol=lf

# Binaries — no line ending conversion
*.png   binary
*.jpg   binary
*.webp  binary
bun.lock binary
