{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --env-file .env --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun dist/index.js",
    "lint": "bunx oxlint src",
    "db:generate": "bunx prisma generate",
    "db:migrate": "bunx prisma migrate dev",
    "db:push": "bunx prisma db push",
    "db:studio": "bunx prisma studio",
    "db:seed": "bun run prisma/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.56",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@prisma/client-runtime-utils": "^7.9.0",
    "ai": "^7.0.83",
    "better-auth": "^1.6.25",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "email-reply-parser": "^2.3.9",
    "express": "^5.1.0",
    "imap-simple": "^5.1.0",
    "mailparser": "^3.9.17",
    "marked": "^18.0.11",
    "nodemailer": "^9.0.6",
    "pg": "^8.22.0",
    "pg-boss": "^12.28.0",
    "prisma": "^7.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/email-reply-parser": "^1.4.2",
    "@types/express": "^5.0.3",
    "@types/imap-simple": "^4.2.10",
    "@types/mailparser": "^3.4.6",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "bun-types": "^1.3.14",
    "typescript": "~5.8.3"
  }
}