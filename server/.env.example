NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/novadesk

# Better Auth — generate secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-char-secret
BETTER_AUTH_URL=http://localhost:3001

# Seed credentials (used by prisma/seed.ts only — never expose in production)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-in-production
SEED_ADMIN_NAME=Admin

# Google AI
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Email (IMAP + SMTP) ──────────────────────────────────────────────────────
# Leave blank to disable the email subsystem entirely (no crash).
# Gmail: generate a 16-char App Password at myaccount.google.com/apppasswords
EMAIL_USER=your_support_email@gmail.com
EMAIL_APP_PASSWORD=your_16_char_app_password
# IMAP (inbound — reading customer emails)
EMAIL_HOST=imap.gmail.com
EMAIL_PORT=993
# SMTP (outbound — sending replies)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
# How often to poll inbox in seconds (default: 60, minimum: 60 due to cron resolution)
EMAIL_POLL_INTERVAL=60
