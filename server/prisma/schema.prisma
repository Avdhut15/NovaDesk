// ─── Data Source ──────────────────────────────────────────────────────────────
datasource db {
  provider = "postgresql"
}

// ─── Generator ────────────────────────────────────────────────────────────────
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum TicketStatus {
  OPEN
  RESOLVED
  CLOSED
}

enum TicketCategory {
  GENERAL_QUESTION
  TECHNICAL_QUESTION
  REFUND_REQUEST
}

// ─── Better Auth Tables ───────────────────────────────────────────────────────
// Generated by: npx @better-auth/cli@latest generate
// Re-run this command after adding/changing Better Auth plugins.

model user {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  role          String?
  deletedAt     DateTime?

  // Relations
  sessions      session[]
  accounts      account[]
  assignedTickets Ticket[] @relation("AssignedAgent")
  createdTickets  Ticket[] @relation("CreatedBy")

  @@map("user")
}

model session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?

  userId String
  user   user   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// ─── Application Models ───────────────────────────────────────────────────────

model Ticket {
  id            String         @id @default(cuid())
  subject       String
  body          String
  status        TicketStatus   @default(OPEN)
  category      TicketCategory @default(GENERAL_QUESTION)
  fromEmail     String?
  fromName      String?
  emailThreadId String?        @unique

  // AI fields
  aiSummary        String?
  aiSuggestedReply String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  assignedAgentId String?
  assignedAgent   user?   @relation("AssignedAgent", fields: [assignedAgentId], references: [id])

  createdById String?
  createdBy   user?   @relation("CreatedBy", fields: [createdById], references: [id])

  replies TicketReply[]

  @@map("tickets")
}

model TicketReply {
  id        String   @id @default(cuid())
  body      String
  fromAgent Boolean  @default(true)
  createdAt DateTime @default(now())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_replies")
}

model KnowledgeBase {
  id        String          @id @default(cuid())
  title     String
  content   String
  category  TicketCategory?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@map("knowledge_base")
}
